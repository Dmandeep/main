# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases (never commit)
*.db
*.sqlite
*.sqlite3

# test artifacts
/playwright-report/
/test-results/

# editors
.idea/

# Prisma generated client
/src/generated/

# One-off exploration scripts. Kept out of the repo deliberately: they are
# written against whatever the database happened to contain that afternoon,
# so they rot immediately and read like project code to anyone browsing it.
# Durable checks live in prisma/.checks and are committed.
/scratch/

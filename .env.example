# --- Database ---
# PostgreSQL is the datastore (docs/adr/0001-database-postgres.md).
# `docker compose up -d` starts a local one on 5433.
DATABASE_URL=postgresql://ideaspace:ideaspace_local_dev@localhost:5433/ideaspace

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
# Production must use its own, not a copy of a developer's.
AUTH_SECRET=

# The deployed origin. OAuth callbacks fail if these do not match it exactly.
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub evidence integration ---
# Personal access token used for read-only repo/commit/PR lookups.
GITHUB_PAT=

# --- Realtime (Pusher) ---
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional. Without it every background job runs inline in the request, which
# is a supported configuration — see docs/DEPLOYMENT.md.
REDIS_URL="redis://localhost:6380"

# Migrations only, where the provider gives separate pooled and direct URLs.
# DIRECT_URL=

# NEVER set ALLOW_DEV_AUTH outside local development. It enables passwordless
# sign-in as any user; src/lib/auth.ts throws on boot if it is set in
# production. It is listed here only so nobody adds it back by accident.

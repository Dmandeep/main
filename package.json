{
  "name": "ideaspace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:all": "tsx prisma/seed.ts && tsx prisma/seed-communities.ts",
    "db:seed:demo": "tsx prisma/seed-communities.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env worker.ts",
    "queue:reconcile": "tsx --env-file-if-exists=.env prisma/.checks/reconcile-evidence.mts",
    "audit": "tsx --env-file-if-exists=.env prisma/.checks/audit.ts",
    "matrix": "tsx --env-file-if-exists=.env prisma/.checks/verify-roles-matrix.mts",
    "seed:check": "tsx --env-file-if-exists=.env prisma/.checks/verify-seed-coverage.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.8.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
